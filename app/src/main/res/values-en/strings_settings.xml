    <string name="settings_row_feedback_body">A remote request being accepted does not mean the agent finished. Verify with a fresh terminal read and later snapshots; when unsure, check before sending again.</string>
    <string name="settings_row_connection">Connection</string>
    <string name="settings_row_connection_body">Refreshes periodically in the foreground; a sync may be delayed by the network or host state. Direct SSH, one channel per request.</string>
